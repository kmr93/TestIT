# TestIT Environment Configuration Example

# Logging level (trace, debug, info, warn, error)
RUST_LOG=info,testit_control_plane=debug

# Web & Control Plane Ports
PORT=8080
WEB_PORT=3000

# Control Plane Master Secret Key (32-byte / 64-char Hex for AES-256-GCM encryption at rest)
# Generate via: openssl rand -hex 32
MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database & NATS
DATABASE_URL=sqlite:///data/db/testit.sqlite?mode=rwc
NATS_URL=nats://nats:4222

# Worker execution
DOCKER_WORKER_IMAGE=testit-worker:latest
MAX_ACTIVE_CASES=4
