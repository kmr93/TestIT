# TestIT Environment Configuration Example

# Logging level (trace, debug, info, warn, error)
RUST_LOG=info,testit_control_plane=debug

# Web & Control Plane Ports
PORT=8080
WEB_PORT=3000

# Control Plane Master Secret Key (32-byte / 64-char Hex for AES-256-GCM encryption at rest)
# Generate via: openssl rand -hex 32
MASTER_KEY_HEX=replace-with-output-of-openssl-rand-hex-32

# Create the first administrator on a new database (12+ character password).
# Existing user accounts are not reset on restart.
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Worker manager bearer secret; use a unique random string of at least 64 characters.
WORKER_MANAGER_TOKEN=replace-with-a-unique-random-64-character-token

# Exact destination hosts permitted for isolated API/database/data nodes.
# The default is empty, which blocks target-bound worker nodes until configured.
WORKER_ALLOWED_HOSTS=

# Set COOKIE_SECURE=false only for local HTTP development without TLS.
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database & NATS
DATABASE_URL=sqlite:///data/db/testit.sqlite?mode=rwc
NATS_URL=nats://nats:4222
NATS_CONTROL_USER=testit-control-plane
NATS_CONTROL_PASSWORD=replace-with-a-unique-random-secret-of-at-least-32-characters

# Worker execution
MAX_ACTIVE_CASES=4
